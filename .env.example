VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Set to true to enable sign-up and multi-user mode (also enable Email provider in Supabase Auth)
VITE_ALLOW_SIGNUP=false

# Canonical site origin for SEO (canonical tag, Open Graph, sitemap, robots).
# No trailing slash. Defaults to https://archespace.app when unset.
VITE_SITE_URL=https://archespace.app
